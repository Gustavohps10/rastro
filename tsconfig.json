{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "tsBuildInfoFile": "./.temps/typescript/root.tsbuildinfo",
    "paths": {
      "@rastrokit/application": ["src/packages/application/src"],
      "@rastrokit/application/*": ["src/packages/application/src/*"],

      "@rastrokit/adapters": ["src/packages/adapters/src"],
      "@rastrokit/adapters/*": ["src/packages/adapters/src/*"],

      "@rastrokit/shared": ["src/packages/shared/src"],
      "@rastrokit/shared/*": ["src/packages/shared/src/*"],

      "@rastrokit/domain": ["src/packages/domain/src"],
      "@rastrokit/domain/*": ["src/packages/domain/src/*"],

      "@rastrokit/sdk": ["src/apps/sdk/src"],
      "@rastrokit/sdk/*": ["src/apps/sdk/src/*"],

      "@/*": [
        "src/packages/ui/src/*",
        "src/packages/application/src/*",
        "src/packages/domain/src/*",
        "src/packages/adapters/src/*",
        "src/packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "mocks/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/apps/desktop",
    "src/apps/landing-page"
  ]
}
