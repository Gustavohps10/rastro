{
  "name": "@rastrokit/datasource-fake",
  "private": true,
  "version": "1.3.0",
  "description": "Datasource fake para testes e validação de envio de dados (1000 tarefas, 1000 apontamentos).",
  "author": "Rastro",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --format esm --dts",
    "typecheck": "tsc --noEmit --tsBuildInfoFile ../../../.temps/typescript/datasource-fake.tsbuildinfo -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@rastrokit/sdk": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
