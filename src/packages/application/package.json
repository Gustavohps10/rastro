{
  "name": "@rastrokit/application",
  "version": "2.4.1",
  "private": true,
  "description": "Contém os serviços e casos de uso (use cases) da aplicação Rastro.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./local-runtime": {
      "import": "./dist/local-runtime.js",
      "types": "./dist/local-runtime.d.ts"
    }
  },
  "scripts": {
    "build": "tsup --format esm,cjs --dts",
    "dev": "tsup --format esm,cjs --watch --no-dts",
    "typecheck": "tsc --noEmit --tsBuildInfoFile ../../../.temps/typescript/application.tsbuildinfo",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@rastrokit/domain": "workspace:*",
    "@rastrokit/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
